#!/usr/bin/env bash
# =============================================================================
#  pbx — единый CLI доставки проектов Pybotx (только для WSL).
#
#  Складывает прежние pack.sh + update.sh в один инструмент: упаковать исходники
#  в архив и доставить их в git-репо с созданием MR/PR.
#
#  Команды:
#    pbx pack    <проект>
#    pbx deliver <проект> <ветка> <сообщение> [архив] [--yes]
#    pbx list
#    pbx help
#
#  Проекты: см. pbx list
# =============================================================================
set -euo pipefail

# ===== Глобальные настройки (env-override) ==================================
# Где лежат ИСХОДНИКИ (рабочее пространство, видимое из WSL по /mnt/c):
WORKSPACE="${PBX_WORKSPACE:-/mnt/c/Users/darkl/Claude/Projects/Pybotx}"
# Где лежат git-репозитории (== GitLab) на рабочем ноуте:
PROJECTS_ROOT="${PBX_PROJECTS_ROOT:-/root}"
# Куда складывать архивы:
DIST_DIR="${PBX_DIST_DIR:-$WORKSPACE/_dist}"
# Каталоги WORKSPACE, которые НЕ являются проектами (кроме _* и .*):
PBX_IGNORE_DIRS="${PBX_IGNORE_DIRS:-docs}"
# Каталог реестра проектов (имя → SRC/REPO + пер-проектные ключи):
PBX_REGISTRY_DIR="${PBX_REGISTRY_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/pbx/projects}"
# scan: на сколько уровней вглубь контейнера искать вложенный git-репо:
PBX_SCAN_MAX_DEPTH="${PBX_SCAN_MAX_DEPTH:-4}"
# Пер-проектные настройки + SRC/REPO резолвит load_config: дефолт →
# $WORKSPACE/.pbx.conf → реестр $PBX_REGISTRY_DIR/<имя>.conf → <SRC>/.pbx.conf → env PBX_*.
# ============================================================================

# ---- вывод -----------------------------------------------------------------
c_blue()  { printf '\033[34m%s\033[0m\n' "$*"; }
c_green() { printf '\033[32m%s\033[0m\n' "$*"; }
c_red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
c_warn()  { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die()     { c_red "❌ $*"; exit 1; }

# ---- утилиты ---------------------------------------------------------------
strip_cr() { printf '%s' "${1//$'\r'/}"; }   # защита от CRLF/копипаста

# Резолв настроек: дефолты → глобальный конфиг → реестр → в-проектный → env.
load_config() {
  local project="${1:-}"
  # 1) встроенные дефолты
  BASE_BRANCH="dev"; TARGET_BRANCH="dev"; FORGE="gitlab"
  EXTRA_PACK_EXCLUDES=(); EXTRA_SYNC_EXCLUDES=()
  SRC=""; REPO=""
  # 2) глобальный конфиг
  [[ -f "$WORKSPACE/.pbx.conf" ]] && source "$WORKSPACE/.pbx.conf"
  # 3) реестр проекта (центральный)
  [[ -n "$project" && -f "$PBX_REGISTRY_DIR/$project.conf" ]] && \
    source "$PBX_REGISTRY_DIR/$project.conf"
  # 4) в-проекте (SRC уже мог задаться реестром; иначе WORKSPACE/<имя>)
  local src_guess="${SRC:-$WORKSPACE/$project}"
  src_guess="${src_guess//$'\r'/}"
  [[ -n "$project" && -f "$src_guess/.pbx.conf" ]] && source "$src_guess/.pbx.conf"
  # 5) env-override (всегда побеждает)
  [[ -n "${PBX_BASE_BRANCH:-}"   ]] && BASE_BRANCH="$PBX_BASE_BRANCH"
  [[ -n "${PBX_TARGET_BRANCH:-}" ]] && TARGET_BRANCH="$PBX_TARGET_BRANCH"
  [[ -n "${PBX_FORGE:-}"         ]] && FORGE="$PBX_FORGE"
  # 6) финализация путей (fallback)
  SRC="${SRC:-$WORKSPACE/$project}"
  REPO="${REPO:-$PROJECTS_ROOT/$project}"
  # 7) защита от CRLF (конфиги на /mnt/c часто с \r), включая SRC/REPO
  local __v __i
  for __v in BASE_BRANCH TARGET_BRANCH FORGE SRC REPO; do
    printf -v "$__v" '%s' "${!__v//$'\r'/}"
  done
  for __i in "${!EXTRA_PACK_EXCLUDES[@]}"; do EXTRA_PACK_EXCLUDES[$__i]="${EXTRA_PACK_EXCLUDES[$__i]//$'\r'/}"; done
  for __i in "${!EXTRA_SYNC_EXCLUDES[@]}"; do EXTRA_SYNC_EXCLUDES[$__i]="${EXTRA_SYNC_EXCLUDES[$__i]//$'\r'/}"; done
  return 0
}

require_wsl() {
  # pbx рассчитан на WSL: исходники на /mnt/c, репозитории в /root.
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null \
    || c_warn "⚠️  Похоже, это не WSL. Пути WORKSPACE/PROJECTS_ROOT могут не совпасть."
}

valid_project() {
  local p="$1"
  [[ -f "$PBX_REGISTRY_DIR/$p.conf" ]] && return 0
  [[ -d "$WORKSPACE/$p" ]] && return 0
  c_red "❌ Проект не найден: $p"
  c_warn "   Есть: $(list_projects | paste -sd', ' -)"
  exit 1
}

# ---- scan: обнаружение репозиториев ----------------------------------------
# URL remote (origin, иначе первый) если <dir> — git-репо с remote; иначе пусто.
repo_remote_url() {
  local dir="$1" url first
  [[ -e "$dir/.git" ]] || return 0
  url="$(git -C "$dir" config --get remote.origin.url 2>/dev/null || true)"
  if [[ -z "$url" ]]; then
    first="$(git -C "$dir" remote 2>/dev/null | head -1 || true)"
    [[ -n "$first" ]] && url="$(git -C "$dir" config --get "remote.$first.url" 2>/dev/null || true)"
  fi
  printf '%s' "$url"
  return 0
}

# Печатает git-репозитории с remote под <dir> не глубже <depth> уровней,
# НЕ спускаясь внутрь уже найденного репо. Пропускает скрытые и node_modules.
scan_inner_repos() {
  local dir="$1" depth="$2" sub base
  [[ "$depth" -le 0 ]] && return 0
  for sub in "$dir"/*/; do
    [[ -d "$sub" ]] || continue
    sub="${sub%/}"
    base="$(basename "$sub")"
    [[ "$base" == .* || "$base" == node_modules ]] && continue
    if [[ -e "$sub/.git" && -n "$(repo_remote_url "$sub")" ]]; then
      printf '%s\n' "$sub"                 # нашли репо — глубже НЕ идём
    else
      scan_inner_repos "$sub" "$((depth-1))"
    fi
  done
  return 0
}

# По подпапкам <root> печатает кандидатов:
#   OK\t<имя>\t<путь-репо>\t<remote>   — репо с remote (сам или единственный в контейнере)
#   WARN\t<имя>\t<причина>             — контейнер с несколькими внутренними репо
# Контейнер = каталог, который сам НЕ git-репо-с-remote (обычный ИЛИ git без
# remote); внутри ищем git-репо с remote на глубину PBX_SCAN_MAX_DEPTH.
scan_candidates() {
  local root="$1" d name url inner cnt only
  for d in "$root"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    name="$(basename "$d")"
    [[ "$name" == _* || "$name" == .* ]] && continue
    [[ "$name" == *$'\t'* || "$name" == *$'\n'* ]] && continue
    # 1) сам каталог — git-репо с remote → берём как есть
    url="$(repo_remote_url "$d")"
    if [[ -n "$url" ]]; then
      printf 'OK\t%s\t%s\t%s\n' "$name" "$d" "$url"
      continue
    fi
    # 2) иначе — контейнер: ищем внутри git-репо с remote (на любой глубине)
    cnt=0; only=""
    while IFS= read -r inner; do
      [[ -n "$inner" ]] || continue
      cnt=$((cnt+1)); only="$inner"
    done < <(scan_inner_repos "$d" "$PBX_SCAN_MAX_DEPTH")
    if [[ "$cnt" -eq 1 ]]; then
      printf 'OK\t%s\t%s\t%s\n' "$name" "$only" "$(repo_remote_url "$only")"
    elif [[ "$cnt" -gt 1 ]]; then
      printf 'WARN\t%s\t%s\n' "$name" "неоднозначный контейнер: $cnt внутренних репо с remote"
    fi
  done
  return 0
}

# Проекты = (реестр $PBX_REGISTRY_DIR/*.conf) ∪ (подпапки WORKSPACE, кроме служебных).
list_projects() {
  local ignore=" ${PBX_IGNORE_DIRS:-docs} " d name
  {
    if [[ -d "$PBX_REGISTRY_DIR" ]]; then
      for d in "$PBX_REGISTRY_DIR"/*.conf; do
        [[ -f "$d" ]] || continue
        printf '%s\n' "$(basename "$d" .conf)"
      done
    fi
    for d in "$WORKSPACE"/*/; do
      [[ -d "$d" ]] || continue
      name="$(basename "$d")"
      [[ "$name" == _* || "$name" == .* ]] && continue
      [[ "$ignore" == *" $name "* ]] && continue
      printf '%s\n' "$name"
    done
  } | sort -u
}

cmd_list() {
  c_blue "🔵 Проекты (реестр ∪ WORKSPACE):"
  local any=0 p
  while IFS= read -r p; do c_green "  • $p"; any=1; done < <(list_projects)
  [[ "$any" -eq 1 ]] || c_warn "  (проектов не найдено)"
}

# ---- exclude builders (pack/deliver) ---------------------------------------
# Аргументы --exclude для tar. GNU tar не якорит паттерны → имя без пути
# исключает совпадения на любой глубине (node_modules в sup-frontend/ и т.п.).
pack_exclude_args() {
  local e
  local base=( node_modules .git .venv __pycache__ .claude CLAUDE.md .pbx.conf )
  for e in "${base[@]}"; do printf -- '--exclude=%s\n' "$e"; done
  printf -- '--exclude=%s\n' '*.pyc'
  for e in "${EXTRA_PACK_EXCLUDES[@]:-}"; do
    [[ -n "$e" ]] && printf -- '--exclude=%s\n' "$e"
  done
  return 0
}

# Аргументы --exclude для rsync (относительно корня переноса).
sync_exclude_args() {
  local e
  local base=( ".git/" ".gitlab-ci.yml" "CLAUDE.md" ".claude/" ".pbx.conf" )
  for e in "${base[@]}"; do printf -- '--exclude=%s\n' "$e"; done
  for e in "${EXTRA_SYNC_EXCLUDES[@]:-}"; do
    [[ -n "$e" ]] && printf -- '--exclude=%s\n' "$e"
  done
  return 0   # иначе статус = последний [[ -n ]] (1 при пустом массиве) → падение под set -e у прямых вызовов
}

# ---- pack ------------------------------------------------------------------
# Упаковать исходники проекта в _dist/<проект>.tar.gz.
# Исключаем всё, что не должно попасть в репозиторий: .git, .venv, node_modules,
# .claude и CLAUDE.md (контекст агента — НЕ коммитим), кэши питона.
cmd_pack() {
  local project; project="$(strip_cr "${1:?Использование: pbx pack <проект>}")"
  valid_project "$project"
  load_config "$project"
  [[ -d "$SRC" ]] || die "Нет исходников: $SRC"
  mkdir -p "$DIST_DIR"
  local out="$DIST_DIR/$project.tar.gz"

  c_blue "🔵 Упаковка $project ($SRC) → $out"
  local excludes; mapfile -t excludes < <(pack_exclude_args)
  tar -C "$(dirname "$SRC")" "${excludes[@]}" -czf "$out" "$(basename "$SRC")"

  c_green "✅ Архив готов: $out"
}

# Пуш ветки + создание MR/PR согласно FORGE.
forge_push() {
  local branch="$1" msg="$2"
  # Push-опции gitlab и --title у gh не допускают переводов строк — в заголовок
  # берём только первую строку (тело коммита сохранено в самом коммите/--body).
  local title="${msg%%$'\n'*}"
  case "$FORGE" in
    gitlab)
      git push -o merge_request.create \
               -o merge_request.target="$TARGET_BRANCH" \
               -o merge_request.title="$title" \
               origin "$branch"
      ;;
    github)
      git push origin "$branch"
      gh pr create --base "$TARGET_BRANCH" --head "$branch" \
                   --title "$title" --body "$msg"
      ;;
    none)
      git push origin "$branch"
      ;;
    *)
      die "Неизвестный FORGE: '$FORGE' (ожидается gitlab|github|none)"
      ;;
  esac
}

# ---- deliver ---------------------------------------------------------------
# Распаковать архив в репозиторий, создать ветку от BASE_BRANCH, закоммитить и
# запушить с созданием MR/PR в TARGET_BRANCH (по умолчанию dev; настраивается).
cmd_deliver() {
  # --yes / -y (в любой позиции) или PBX_ASSUME_YES=1 — пропустить guard-подтверждение
  local assume_yes="${PBX_ASSUME_YES:-0}"
  local _a _args=()
  for _a in "$@"; do
    case "$_a" in
      --yes|-y) assume_yes=1 ;;
      *)        _args+=("$_a") ;;
    esac
  done
  set -- ${_args[@]+"${_args[@]}"}

  local project branch msg archive
  project="$(strip_cr "${1:?Использование: pbx deliver <проект> <ветка> <сообщение> [архив] [--yes]}")"
  branch="$(strip_cr "${2:?Укажи ветку (feature/PROJ-123-...) 2-м аргументом}")"
  msg="$(strip_cr "${3:?Укажи сообщение коммита 3-м аргументом}")"
  archive="$(strip_cr "${4:-$DIST_DIR/$project.tar.gz}")"

  # Windows-путь → WSL (для archive)
  if command -v wslpath >/dev/null 2>&1 && [[ "$archive" == *:\\* || "$archive" == *:/* ]]; then
    archive="$(wslpath -u "$archive")"
  fi

  load_config "$project"
  local repo="$REPO"

  [[ -f "$archive" ]] || die "Архив не найден: $archive (сначала: pbx pack $project)"
  # Проверка конвенции ветки — предупреждаем, но не блокируем
  [[ "$branch" =~ ^(feature|fix|hotfix|bugfix|chore)/ ]] \
    || c_warn "⚠️  Ветка '$branch' не по конвенции feature/PROJ-123-… — продолжаю как есть."
  [[ -d "$repo/.git" ]] || die "Не git-репозиторий: $repo"

  cd "$repo"
  # Не раздувать MR mode-изменениями (Windows ставит 0755 всем файлам)
  git config core.fileMode false

  c_blue "🔵 Обновляю $BASE_BRANCH"
  git checkout "$BASE_BRANCH"
  git pull origin "$BASE_BRANCH"

  # Распаковка во временную папку
  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  case "$archive" in
    *.zip)          unzip -q "$archive" -d "$tmp" ;;
    *.tar.gz|*.tgz) tar -xzf "$archive" -C "$tmp" ;;
    *.tar)          tar -xf "$archive" -C "$tmp" ;;
    *) die "Неизвестный формат архива: $archive" ;;
  esac
  # Если внутри единственный корневой каталог — заходим в него
  local inner="$tmp"
  if [[ $(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l) -eq 1 \
     && $(find "$tmp" -mindepth 1 -maxdepth 1 -type d | wc -l) -eq 1 ]]; then
    inner="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d)"
  fi

  # Полная синхронизация (сохраняем служебные файлы репозитория)
  c_blue "🔵 Синхронизирую файлы в $repo"
  local syncex; mapfile -t syncex < <(sync_exclude_args)
  rsync -a --delete "${syncex[@]}" "$inner"/ "$repo"/
  rm -rf "$tmp"        # tmp больше не нужен после синка
  trap - RETURN        # tmp уже удалён — снять RETURN-trap, чтобы он не сработал на возврате функции

  # Ветка от BASE_BRANCH → коммит → пуш с MR/PR в TARGET_BRANCH
  git checkout -b "$branch"
  git add -A
  if git diff --cached --quiet; then
    c_warn "Изменений нет — выходим."
    git checkout "$BASE_BRANCH"
    git branch -d "$branch"
    return 0
  fi

  # ---- guard: показать changeset и подтвердить перед commit/push -------------
  # Ловит «зеркальную» доставку от устаревшего снимка: rsync --delete молча
  # откатывает/удаляет чужую влитую в BASE_BRANCH работу. Обход: --yes / PBX_ASSUME_YES=1.
  c_blue "📋 Будет закоммичено в '$branch' → MR в '$TARGET_BRANCH' (git diff --cached --stat):"
  git diff --cached --stat
  local deleted f; deleted="$(git diff --cached --diff-filter=D --name-only)"
  if [[ -n "$deleted" ]]; then
    c_warn "⚠️  БУДУТ УДАЛЕНЫ файлы из '$BASE_BRANCH' (частая причина — устаревший снимок + rsync --delete):"
    while IFS= read -r f; do c_warn "     - $f"; done <<< "$deleted"
  fi
  if [[ "$assume_yes" == 1 ]]; then
    c_warn "   (--yes / PBX_ASSUME_YES — подтверждение пропущено)"
  elif [[ -t 0 ]]; then
    local ans=""
    read -r -p "Проверь список выше. Продолжить коммит и пуш MR? [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] \
      || die "Отменено. Ты на ветке '$branch'; проверь diff, затем откати: git checkout -f $BASE_BRANCH && git branch -D $branch"
  else
    die "Доставка прервана (не интерактивно, без подтверждения). Проверь diff выше; если всё верно — повтори с --yes."
  fi

  git commit -m "$msg"
  forge_push "$branch" "$msg"

  case "$FORGE" in
    none) c_green "✅ $project: ветка '$branch' от '$BASE_BRANCH' запушена (без MR/PR) — «$msg».";;
    *)    c_green "✅ $project: ветка '$branch' от '$BASE_BRANCH', MR/PR в '$TARGET_BRANCH' — «$msg».";;
  esac
}


# ---- add -------------------------------------------------------------------
# Завести проект в реестр: $PBX_REGISTRY_DIR/<имя>.conf с SRC.
cmd_add() {
  local name src
  name="$(strip_cr "${1:?Использование: pbx add <имя> [путь-SRC]}")"
  src="$(strip_cr "${2:-$PWD}")"
  [[ -d "$src" ]] || die "Нет папки исходников: $src"
  src="$(cd "$src" && pwd)"
  mkdir -p "$PBX_REGISTRY_DIR"
  local f="$PBX_REGISTRY_DIR/$name.conf"
  [[ -e "$f" ]] && die "Уже в реестре: $f (отредактируй вручную)"
  cat > "$f" <<EOF
# Реестр pbx: проект $name
SRC=$src
# REPO=/root/$name       # цель доставки (иначе \$PROJECTS_ROOT/$name)
# BASE_BRANCH=dev
# TARGET_BRANCH=dev      # master-MR обычно вручную перед релизом
# FORGE=gitlab           # gitlab | github | none
EOF
  c_green "✅ Проект '$name' в реестре: $f"
  c_blue  "   SRC=$src — при необходимости отредактируй $f"
}

# ---- scan ------------------------------------------------------------------
# Найти репозитории в каталоге и создать записи реестра (REPO или SRC).
cmd_scan() {
  local field="" dir="" dry=0 a dirset=0
  for a in "$@"; do
    a="$(strip_cr "$a")"
    case "$a" in
      --repo) [[ -n "$field" && "$field" != "REPO" ]] && die "Укажи только один из --repo/--src"; field="REPO" ;;
      --src)  [[ -n "$field" && "$field" != "SRC"  ]] && die "Укажи только один из --repo/--src"; field="SRC" ;;
      --dry-run) dry=1 ;;
      -*) die "Неизвестный флаг: $a (ожидается --repo|--src|--dry-run)" ;;
      *) [[ "$dirset" -eq 1 ]] && die "Лишний аргумент: $a (каталог указывается один)"; dir="$a"; dirset=1 ;;
    esac
  done
  [[ -n "$field" ]] || die "Укажи --repo или --src. Использование: pbx scan (--repo|--src) [каталог] [--dry-run]"
  if [[ -z "$dir" ]]; then
    [[ "$field" == "REPO" ]] && dir="$PROJECTS_ROOT" || dir="$WORKSPACE"
  fi
  [[ -d "$dir" ]] || die "Каталог не найден: $dir"
  [[ "$dry" -eq 1 ]] || mkdir -p "$PBX_REGISTRY_DIR"

  local drynote=""; [[ "$dry" -eq 1 ]] && drynote="  (dry-run)"
  c_blue "🔵 Скан $dir → поле $field$drynote"

  local created=0 skipped=0 warned=0 kind name path url f forge
  while IFS=$'\t' read -r kind name path url; do
    if [[ "$kind" == "WARN" ]]; then
      c_warn "  ⚠️  $name: $path"; warned=$((warned+1)); continue
    fi
    f="$PBX_REGISTRY_DIR/$name.conf"
    if [[ -e "$f" ]]; then
      c_warn "  • $name — пропущено (уже есть)"; skipped=$((skipped+1)); continue
    fi
    forge=""
    [[ "$url" == *"@github.com:"* || "$url" == *"//github.com/"* ]] && forge=$'\nFORGE=github'
    if [[ "$dry" -eq 1 ]]; then
      c_green "  + $name → $field=$path (dry-run)"
    else
      printf '# Реестр pbx (scan): проект %s\n%s=%s%s\n' "$name" "$field" "$path" "$forge" > "$f"
      c_green "  + $name → $field=$path"
    fi
    created=$((created+1))
  done < <(scan_candidates "$dir")

  c_green "✅ Скан завершён: создано $created, пропущено $skipped, предупреждений $warned"
  return 0
}

# ---- help ------------------------------------------------------------------
cmd_help() {
  cat <<'EOF'
pbx — доставка проектов Pybotx (WSL)

  pbx pack    <проект>                          упаковать в _dist/<проект>.tar.gz
  pbx deliver <проект> <ветка> <сообщение> [архив] [--yes]
                                                распаковать в репо, ветка от BASE_BRANCH, MR/PR в TARGET_BRANCH (см. FORGE)
                                                перед коммитом показывает changeset и просит подтверждения (--yes/PBX_ASSUME_YES — пропустить)
  pbx add     <имя> [путь]                      завести проект в реестр (SRC=путь|$PWD)
  pbx scan (--repo|--src) [каталог] [--dry-run]  заполнить реестр из найденных репо
  pbx list                                      показать проекты (реестр ∪ WORKSPACE)
  pbx help                                      эта справка

Проекты: см. `pbx list`

Примеры:
  pbx pack <проект>
  pbx deliver <проект> feature/SUBA-2147-fix-name "Описание изменений"
