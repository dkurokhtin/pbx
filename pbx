#!/usr/bin/env bash
# =============================================================================
#  pbx — единый CLI доставки проектов Pybotx (только для WSL).
#
#  Складывает прежние pack.sh + update.sh в один инструмент и добавляет
#  pipeline-команду ship (упаковать → доставить → задеплоить одной строкой).
#  deploy делегируется родному scripts/deploy.sh проекта — он корректен и
#  дублировать его не нужно.
#
#  Команды:
#    pbx pack    <проект>
#    pbx deliver <проект> <ветка> <сообщение> [архив]
#    pbx deploy  <проект> [env]
#    pbx ship    <проект> <ветка> <сообщение> [env]
#    pbx list
#    pbx help
#
#  Проекты: см. pbx list
# =============================================================================
set -euo pipefail

# ===== Глобальные настройки (env-override) ==================================
# Где лежат ИСХОДНИКИ (рабочее пространство, видимое из WSL по /mnt/c):
WORKSPACE="${PBX_WORKSPACE:-/mnt/c/Users/darkl/Claude/Projects/Pybotx}"
# Где лежат git-репозитории (== GitLab) на рабочем ноуте:
PROJECTS_ROOT="${PBX_PROJECTS_ROOT:-/root}"
# Куда складывать архивы:
DIST_DIR="${PBX_DIST_DIR:-$WORKSPACE/_dist}"
# Каталоги WORKSPACE, которые НЕ являются проектами (кроме _* и .*):
PBX_IGNORE_DIRS="${PBX_IGNORE_DIRS:-docs}"
# Пер-проектные настройки (BASE_BRANCH/TARGET_BRANCH/DEFAULT_ENV/FORGE и
# excludes) резолвит load_config: дефолт → $WORKSPACE/.pbx.conf →
# $WORKSPACE/<проект>/.pbx.conf → env PBX_*.
# ============================================================================

# ---- вывод -----------------------------------------------------------------
c_blue()  { printf '\033[34m%s\033[0m\n' "$*"; }
c_green() { printf '\033[32m%s\033[0m\n' "$*"; }
c_red()   { printf '\033[31m%s\033[0m\n' "$*" >&2; }
c_warn()  { printf '\033[33m%s\033[0m\n' "$*" >&2; }
die()     { c_red "❌ $*"; exit 1; }

# ---- утилиты ---------------------------------------------------------------
strip_cr() { printf '%s' "${1//$'\r'/}"; }   # защита от CRLF/копипаста

# Резолв настроек: дефолты → глобальный конфиг → проектный конфиг → env.
load_config() {
  local project="${1:-}"
  # 1) встроенные дефолты
  BASE_BRANCH="dev"
  TARGET_BRANCH="dev"      # MR/PR по умолчанию в dev; master-MR делается вручную перед релизом
  DEFAULT_ENV="dev"
  FORGE="gitlab"
  EXTRA_PACK_EXCLUDES=()
  EXTRA_SYNC_EXCLUDES=()
  # 2) глобальный конфиг
  [[ -f "$WORKSPACE/.pbx.conf" ]] && source "$WORKSPACE/.pbx.conf"
  # 3) пер-проектный конфиг
  [[ -n "$project" && -f "$WORKSPACE/$project/.pbx.conf" ]] && \
    source "$WORKSPACE/$project/.pbx.conf"
  # 4) env-override (всегда побеждает)
  [[ -n "${PBX_BASE_BRANCH:-}"   ]] && BASE_BRANCH="$PBX_BASE_BRANCH"
  [[ -n "${PBX_TARGET_BRANCH:-}" ]] && TARGET_BRANCH="$PBX_TARGET_BRANCH"
  [[ -n "${PBX_DEFAULT_ENV:-}"   ]] && DEFAULT_ENV="$PBX_DEFAULT_ENV"
  [[ -n "${PBX_FORGE:-}"         ]] && FORGE="$PBX_FORGE"
  # Защита от CRLF: конфиги на /mnt/c часто сохраняются Windows-редактором с \r
  local __v __i
  for __v in BASE_BRANCH TARGET_BRANCH DEFAULT_ENV FORGE; do
    printf -v "$__v" '%s' "${!__v//$'\r'/}"
  done
  for __i in "${!EXTRA_PACK_EXCLUDES[@]}"; do EXTRA_PACK_EXCLUDES[$__i]="${EXTRA_PACK_EXCLUDES[$__i]//$'\r'/}"; done
  for __i in "${!EXTRA_SYNC_EXCLUDES[@]}"; do EXTRA_SYNC_EXCLUDES[$__i]="${EXTRA_SYNC_EXCLUDES[$__i]//$'\r'/}"; done
  return 0   # иначе статус функции = статус последнего && (1, если PBX_FORGE не задан) → падение под set -e
}

require_wsl() {
  # pbx рассчитан на WSL: исходники на /mnt/c, репозитории в /root.
  grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null \
    || c_warn "⚠️  Похоже, это не WSL. Пути WORKSPACE/PROJECTS_ROOT могут не совпасть."
}

valid_project() {
  local p="$1"
  [[ -d "$WORKSPACE/$p" ]] && return 0
  c_red "❌ Нет папки проекта: $WORKSPACE/$p"
  c_warn "   Доступные: $(list_projects | paste -sd', ' -)"
  exit 1
}

# Проекты = подкаталоги WORKSPACE, кроме служебных (_*, .*, PBX_IGNORE_DIRS).
list_projects() {
  local ignore=" ${PBX_IGNORE_DIRS:-docs} " d name
  for d in "$WORKSPACE"/*/; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    [[ "$name" == _* || "$name" == .* ]] && continue
    [[ "$ignore" == *" $name "* ]] && continue
    printf '%s\n' "$name"
  done | sort
}

cmd_list() {
  c_blue "🔵 Проекты в $WORKSPACE:"
  local any=0 p
  while IFS= read -r p; do c_green "  • $p"; any=1; done < <(list_projects)
  [[ "$any" -eq 1 ]] || c_warn "  (проектов не найдено)"
}

# ---- exclude builders (pack/deliver) ---------------------------------------
# Аргументы --exclude для tar (пути относительно WORKSPACE → с префиксом проекта).
pack_exclude_args() {
  local project="$1" e
  local base=( ".git" ".venv" "node_modules" "front/node_modules" \
               ".claude" "CLAUDE.md" ".pbx.conf" )
  for e in "${base[@]}"; do printf -- '--exclude=%s\n' "$project/$e"; done
  printf -- '--exclude=%s\n' '*/__pycache__'
  printf -- '--exclude=%s\n' '*.pyc'
  for e in "${EXTRA_PACK_EXCLUDES[@]:-}"; do
    [[ -n "$e" ]] && printf -- '--exclude=%s\n' "$project/$e"
  done
  return 0   # иначе статус = последний [[ -n ]] (1 при пустом массиве) → падение под set -e у прямых вызовов
}

# Аргументы --exclude для rsync (относительно корня переноса).
sync_exclude_args() {
  local e
  local base=( ".git/" ".gitlab-ci.yml" "CLAUDE.md" ".claude/" ".pbx.conf" )
  for e in "${base[@]}"; do printf -- '--exclude=%s\n' "$e"; done
  for e in "${EXTRA_SYNC_EXCLUDES[@]:-}"; do
    [[ -n "$e" ]] && printf -- '--exclude=%s\n' "$e"
  done
  return 0   # иначе статус = последний [[ -n ]] (1 при пустом массиве) → падение под set -e у прямых вызовов
}

# ---- pack ------------------------------------------------------------------
# Упаковать исходники проекта в _dist/<проект>.tar.gz.
# Исключаем всё, что не должно попасть в репозиторий: .git, .venv, node_modules,
# .claude и CLAUDE.md (контекст агента — НЕ коммитим), кэши питона.
cmd_pack() {
  local project; project="$(strip_cr "${1:?Использование: pbx pack <проект>}")"
  valid_project "$project"
  load_config "$project"
  mkdir -p "$DIST_DIR"
  local out="$DIST_DIR/$project.tar.gz"

  c_blue "🔵 Упаковка $project → $out"
  local excludes; mapfile -t excludes < <(pack_exclude_args "$project")
  tar -C "$WORKSPACE" "${excludes[@]}" -czf "$out" "$project"

  c_green "✅ Архив готов: $out"
  PBX_LAST_ARCHIVE="$out"   # для ship
}

# Пуш ветки + создание MR/PR согласно FORGE.
forge_push() {
  local branch="$1" msg="$2"
  case "$FORGE" in
    gitlab)
      git push -o merge_request.create \
               -o merge_request.target="$TARGET_BRANCH" \
               -o merge_request.title="$msg" \
               origin "$branch"
      ;;
    github)
      git push origin "$branch"
      gh pr create --base "$TARGET_BRANCH" --head "$branch" \
                   --title "$msg" --body "$msg"
      ;;
    none)
      git push origin "$branch"
      ;;
    *)
      die "Неизвестный FORGE: '$FORGE' (ожидается gitlab|github|none)"
      ;;
  esac
}

# ---- deliver ---------------------------------------------------------------
# Распаковать архив в репозиторий, создать ветку от BASE_BRANCH, закоммитить и
# запушить с созданием MR/PR в TARGET_BRANCH (по умолчанию dev; настраивается).
cmd_deliver() {
  local project branch msg archive
  project="$(strip_cr "${1:?Использование: pbx deliver <проект> <ветка> <сообщение> [архив]}")"
  branch="$(strip_cr "${2:?Укажи ветку (feature/PROJ-123-...) 2-м аргументом}")"
  msg="$(strip_cr "${3:?Укажи сообщение коммита 3-м аргументом}")"
  archive="$(strip_cr "${4:-$DIST_DIR/$project.tar.gz}")"

  # Windows-путь → WSL
  if command -v wslpath >/dev/null 2>&1 && [[ "$archive" == *:\\* || "$archive" == *:/* ]]; then
    archive="$(wslpath -u "$archive")"
  fi
  [[ -f "$archive" ]] || die "Архив не найден: $archive (сначала: pbx pack $project)"

  # Проверка конвенции ветки — предупреждаем, но не блокируем
  [[ "$branch" =~ ^(feature|fix|hotfix|bugfix|chore)/ ]] \
    || c_warn "⚠️  Ветка '$branch' не по конвенции feature/PROJ-123-… — продолжаю как есть."

  local repo="$PROJECTS_ROOT/$project"
  [[ -d "$repo/.git" ]] || die "Не git-репозиторий: $repo"
  load_config "$project"

  cd "$repo"
  # Не раздувать MR mode-изменениями (Windows ставит 0755 всем файлам)
  git config core.fileMode false

  c_blue "🔵 Обновляю $BASE_BRANCH"
  git checkout "$BASE_BRANCH"
  git pull origin "$BASE_BRANCH"

  # Распаковка во временную папку
  local tmp; tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' RETURN
  case "$archive" in
    *.zip)          unzip -q "$archive" -d "$tmp" ;;
    *.tar.gz|*.tgz) tar -xzf "$archive" -C "$tmp" ;;
    *.tar)          tar -xf "$archive" -C "$tmp" ;;
    *) die "Неизвестный формат архива: $archive" ;;
  esac
  # Если внутри единственный корневой каталог — заходим в него
  local inner="$tmp"
  if [[ $(find "$tmp" -mindepth 1 -maxdepth 1 | wc -l) -eq 1 \
     && $(find "$tmp" -mindepth 1 -maxdepth 1 -type d | wc -l) -eq 1 ]]; then
    inner="$(find "$tmp" -mindepth 1 -maxdepth 1 -type d)"
  fi

  # Полная синхронизация (сохраняем служебные файлы репозитория)
  c_blue "🔵 Синхронизирую файлы в $repo"
  local syncex; mapfile -t syncex < <(sync_exclude_args)
  rsync -a --delete "${syncex[@]}" "$inner"/ "$repo"/

  # Ветка от BASE_BRANCH → коммит → пуш с MR/PR в TARGET_BRANCH
  git checkout -b "$branch"
  git add -A
  if git diff --cached --quiet; then
    c_warn "Изменений нет — выходим."
    git checkout "$BASE_BRANCH"
    git branch -d "$branch"
    return 0
  fi
  git commit -m "$msg"
  forge_push "$branch" "$msg"

  case "$FORGE" in
    none) c_green "✅ $project: ветка '$branch' от '$BASE_BRANCH' запушена (без MR/PR) — «$msg».";;
    *)    c_green "✅ $project: ветка '$branch' от '$BASE_BRANCH', MR/PR в '$TARGET_BRANCH' — «$msg».";;
  esac
}

# ---- deploy ----------------------------------------------------------------
# Делегируем родному скрипту проекта (собирает фронт+бэк, образ на REMOTE_HOST,
# перезапуск контейнера, ожидание healthy). Миграции применяются автоматически.
cmd_deploy() {
  local project env
  project="$(strip_cr "${1:?Использование: pbx deploy <проект> [env]}")"
  load_config "$project"
  env="$(strip_cr "${2:-$DEFAULT_ENV}")"

  local scripts="$PROJECTS_ROOT/$project/scripts"
  [[ -x "$scripts/deploy.sh" ]] || die "Нет $scripts/deploy.sh"

  c_blue "🔵 Деплой $project → $env"
  ( cd "$scripts" && ./deploy.sh "$env" )
  c_green "✅ Деплой $project ($env) завершён."
}

# ---- ship ------------------------------------------------------------------
# Полный конвейер: pack → deliver → deploy.
cmd_ship() {
  local project branch msg env
  project="$(strip_cr "${1:?Использование: pbx ship <проект> <ветка> <сообщение> [env]}")"
  load_config "$project"
  branch="$(strip_cr "${2:?Укажи ветку (feature/PROJ-123-...) 2-м аргументом}")"
  msg="$(strip_cr "${3:?Укажи сообщение коммита 3-м аргументом}")"
  env="$(strip_cr "${4:-$DEFAULT_ENV}")"

  c_blue "🚀 ship $project → ветка '$branch', env '$env'"
  cmd_pack "$project"
  cmd_deliver "$project" "$branch" "$msg" "$PBX_LAST_ARCHIVE"
  cmd_deploy "$project" "$env"
  c_green "🎉 Готово: $project доставлен и задеплоен ($env)."
}

# ---- help ------------------------------------------------------------------
cmd_help() {
  cat <<'EOF'
pbx — доставка проектов Pybotx (WSL)

  pbx pack    <проект>                          упаковать в _dist/<проект>.tar.gz
  pbx deliver <проект> <ветка> <сообщение> [архив]
                                                распаковать в репо, ветка от BASE_BRANCH, MR/PR в TARGET_BRANCH (см. FORGE)
  pbx deploy  <проект> [env]                    собрать образ и задеплоить (env: dev|test|prod)
  pbx ship    <проект> <ветка> <сообщение> [env]  всё сразу: pack → deliver → deploy
  pbx list                                      показать проекты в WORKSPACE
  pbx help                                      эта справка

Проекты: см. `pbx list`

Примеры:
  pbx pack <проект>
  pbx deliver <проект> feature/SUBA-2147-fix-name "Описание изменений"
  pbx deploy <проект> test
  pbx ship <проект> feature/SUBA-2147-new-feature "Описание изменений" dev

Переопределяемые переменные окружения:
  PBX_WORKSPACE (=/mnt/c/Users/darkl/Claude/Projects/Pybotx)
  PBX_PROJECTS_ROOT (=/root)   PBX_DIST_DIR   PBX_BASE_BRANCH (=dev)
  PBX_TARGET_BRANCH (=dev)     PBX_DEFAULT_ENV (=dev)  PBX_FORGE (=gitlab)

Пер-проектный конфиг ($WORKSPACE/<проект>/.pbx.conf, необязателен):
  BASE_BRANCH=dev            от какой ветки ответвляемся
  TARGET_BRANCH=dev          куда MR/PR (master-MR обычно вручную перед релизом)
  DEFAULT_ENV=dev            окружение деплоя
  FORGE=gitlab               gitlab | github | none
  EXTRA_PACK_EXCLUDES=(dist)  доп. исключения упаковки
  EXTRA_SYNC_EXCLUDES=(build) доп. исключения синка
  Слои: дефолт → $WORKSPACE/.pbx.conf → проектный → env PBX_* (env побеждает).
EOF
}

# ---- диспетчер -------------------------------------------------------------
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    pack)               require_wsl; cmd_pack "$@" ;;
    deliver|update)     require_wsl; cmd_deliver "$@" ;;
    deploy)             require_wsl; cmd_deploy "$@" ;;
    ship)               require_wsl; cmd_ship "$@" ;;
    list|ls)            cmd_list ;;
    help|-h|--help)     cmd_help ;;
    *) c_red "Неизвестная команда: $cmd"; echo; cmd_help; exit 1 ;;
  esac
}

# Запускаем main только при прямом вызове; при `source` (тесты) — нет.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
